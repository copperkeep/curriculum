# syntax=docker/dockerfile:1
#
# The shipping `content` image: the platform's base (nginx plus the serving policy) with
# this release's built JSON copied in. The nginx config lives in the platform repo so
# there is one copy of it, not two that drift.
ARG BASE_VERSION=0.1.3
FROM python:3.12-slim AS build

WORKDIR /src
RUN pip install --no-cache-dir pyyaml
COPY . .
RUN python tools/check.py && python tools/build.py --out /dist

FROM ghcr.io/copperkeep/content-base:${BASE_VERSION}
# Into content/, not the web root. The service is mounted at /content/ on the shared
# origin, so the file path and the public path are the same thing and nothing in front
# has to rewrite anything. Platform 0.1.3 and newer expects this.
COPY --from=build /dist /usr/share/nginx/html/content
